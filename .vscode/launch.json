{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug PC Benchmark Analyzer",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/src/index.js",
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "restart": true,
      "runtimeArgs": [
        "--experimental-specifier-resolution=node"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug with Verbose Logging",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/src/index.js",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "*"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "restart": true,
      "runtimeArgs": [
        "--experimental-specifier-resolution=node"
      ]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Running Process",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug scrapeNotebookcheck",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/src/index.js",
      "env": {
        "NODE_ENV": "development"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "restart": true,
      "runtimeArgs": [
        "--experimental-specifier-resolution=node"
      ],
      "stopOnEntry": false,
      "preLaunchTask": null
    }
  ]
}
